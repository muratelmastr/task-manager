{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email != null && root.child('users/' + auth.token.email.toLowerCase().replace('.', '%2E')).exists()",
      ".write": false
    },
    "tasks": {
      ".read": "auth != null && auth.token.email != null && root.child('users/' + auth.token.email.toLowerCase().replace('.', '%2E')).exists()",
      "$key": {
        ".write": "auth != null && auth.token.email != null && root.child('users/' + auth.token.email.toLowerCase().replace('.', '%2E')).exists() && (newData.exists() || data.child('durum').val() !== 'Tamamlandı')",
        ".validate": "$key.length <= 120 && newData.hasChildren(['id', 'gorev', 'durum']) && (!data.child('createdBy').exists() || newData.child('createdBy').val() === data.child('createdBy').val())",
        "id": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "gorev": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "alan": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "sahip": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "durum": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "oncelik": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'Yüksek' || newData.val() === 'Orta' || newData.val() === 'Düşük')" },
        "tamamlanmaTarihi": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
        "completedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "$other": { ".validate": false }
      }
    },
    "lists": {
      ".read": "auth != null && auth.token.email != null && root.child('users/' + auth.token.email.toLowerCase().replace('.', '%2E')).exists()",
      "$key": {
        ".write": "auth != null && auth.token.email != null && root.child('users/' + auth.token.email.toLowerCase().replace('.', '%2E')).exists() && newData.exists()",
        ".validate": "($key === 'alan' || $key === 'sahip' || $key === 'durum') && newData.isString() && newData.val().length <= 20000"
      }
    }
  }
}
